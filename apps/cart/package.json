{
  "name": "@react-mfe/cart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5102 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5102 --strictPort"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "nx": {
    "projectType": "application",
    "sourceRoot": "apps/cart/src",
    "tags": [
      "scope:cart",
      "type:provider"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "vite",
          "cwd": "apps/cart"
        },
        "dependsOn": [
          "@react-mfe/shell:dev"
        ]
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vite build",
          "cwd": "apps/cart"
        }
      }
    }
  }
}
