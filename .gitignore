# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# module federation runtime diagnostics + cache
.mf/
**/node_modules/.federation/

# generated .d.ts files emitted alongside source
packages/ui/src/**/*.d.ts

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

vitest.config.*.timestamp*
.nx/polygraph

# Secrets / local env (Vite reads apps/shell/.env)
.env
**/.env
!**/.env.example

# Polyrepo: only shell lives in this platform repo.
# Remotes are separate git repos — clone with: bun run pull-remote --name <remote>
/apps/*
!/apps/shell/
!/apps/shell/**
!/apps/README.md
# Re-hide secrets after shell un-ignore
/apps/shell/.env
