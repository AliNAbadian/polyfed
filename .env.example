# OIDC (Identity Provider)
# Use "disabled" for local UI without IdP
VITE_OIDC_AUTHORITY=https://your-idp.example.com
VITE_OIDC_CLIENT_ID=sale-platform-spa
VITE_OIDC_SCOPE=openid profile email offline_access

# Shared API for axios client (@react-mfe/auth getApiClient)
VITE_API_BASE_URL=https://api.example.com
